# ── FEL DRONE — quote API environment ─────────────────────────────
# Copy to .env for local runs (git-ignored). On Vercel, set these in
# Project Settings → Environment Variables. NOTHING here is required for
# the site itself — only for the request API; without them the API still
# accepts and queues requests in memory (dev) or refuses to deploy secrets.

# Storage for service requests (recommended: Upstash Redis — free tier).
# Without these, requests go to the in-memory store (dev only, volatile).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email notification when a new request arrives (provider: Resend).
# Without these three, intake still works; no email is sent (logged).
RESEND_API_KEY=
EMAIL_FROM=FEL DRONE Website <notifier@feldrone.dz>
NOTIFY_TO=contact.feldrone@gmail.com

# Private token for /api/quote-requests (list/update requests).
# Generate: openssl rand -hex 24
ADMIN_TOKEN=

# Allowed origin(s) for CORS (comma-separated). Same-origin requests need none.
SITE_ORIGIN=https://www.feldrone.dz

# Optional tuning
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_PER_DAY=10
